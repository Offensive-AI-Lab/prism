# Copy to .env and fill in. Loaded by prism.common.env.load_env() and recipes/_lib.sh
# (values already set in the environment take precedence).

# --- Judge endpoint (any OpenAI-compatible server; see scripts/serve_judge.sh) ---
# The released runs used Gemma 4 31B-it (HF: google/gemma-4-31B-it) served by vLLM
# with reasoning off; PRISM_JUDGE_MODEL is the *served* model name.
PRISM_JUDGE_BASE_URL=http://localhost:8088/v1
PRISM_JUDGE_MODEL=gemma4-31B-it
PRISM_JUDGE_API_KEY=not-needed
# Only for scripts/serve_judge.sh: local dir or HF id of the judge weights.
# PRISM_JUDGE_MODEL_PATH=google/gemma-4-31B-it

# --- Target-model server for oracle data generation (scripts/generate_dataset.sh) ---
# DATAGEN_BASE_URL=http://localhost:8089/v1
# DATAGEN_MODEL=Qwen/Qwen3.5-9B

# --- Experiment tracking (optional) ---
# With no key and no `wandb login`, the trainers run with W&B disabled.
# Force a mode with WANDB_MODE=online|offline|disabled.
WANDB_API_KEY=

# --- HuggingFace (needed for gated target models, e.g. gemma-2-9b-it) ---
HF_TOKEN=
# HF_HUB_CACHE=/shared/hf-cache   # weights cache shared across nodes
# HF_HUB_OFFLINE=1                # compute nodes without internet

# --- Local storage roots used by recipes/ ---
# Oracle dataset (prompt-only/jsonl/*.jsonl + valid_record_ids.json) and the
# precomputed activation caches (precomputed/<model>-prompt-only/) live under here.
PRISM_DATA_DIR=
# Training checkpoints are written under here.
PRISM_CKPT_DIR=
# Optional overrides honoured by every recipe:
# PRISM_DATASET_SRC=      # dataset directory, if not $PRISM_DATA_DIR/prompt-only
# PRISM_PRECOMPUTED_DIR=  # reuse an activation cache extracted elsewhere
# PRISM_ON_THE_FLY=1      # extract activations in-loop instead of using the cache
#                         # (standalone trainers: --dataset-paths / PRISM_DATASET_PATHS)
# PRISM_HOOK_LAYER=       # override the profile's hook layer
# PRISM_SEED=             # training seed (released runs: 42)
